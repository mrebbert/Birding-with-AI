# Copy to .env in the repository root and fill in. .env stays out of git.
#
# docker-compose.yml reads these directly. The Caddyfile and the Home Assistant
# YAML carry the same names as literal placeholders; substitute them with
#   ./snippets/scripts/apply-placeholders.sh

# --- Camera -----------------------------------------------------------------
# Address serving the RTSP stream. On UniFi this is the NVR or gateway, not the
# address the Protect management interface shows.
CAMERA_HOST=192.168.1.10
# One token per quality level. The camera reissues it when RTSP is toggled.
RTSP_TOKEN=changeme
RTSP_PORT=7447

# --- Hostnames and ports ----------------------------------------------------
BIRDNET_HOSTNAME=birdnet.example.lan
SAEZURI_HOSTNAME=birds.example.lan
BIRDNET_PORT=8081
SAEZURI_PORT=8090

# --- Home Assistant ---------------------------------------------------------
# Address of your Home Assistant instance, for the frame-ancestors header.
HA_HOSTNAME=home.example.lan
# How BirdNET-Go names the audio source inside entity IDs, lowercase with
# underscores. Read it off sensor.birdnet_go_<SOURCE_SLUG>_last_species.
SOURCE_SLUG=backyard
# Notify service for the new-species message.
NOTIFY_SERVICE=notify.mobile_app_your_phone

# --- MQTT -------------------------------------------------------------------
# Entered in the BirdNET-Go interface, not read from this file.
MQTT_HOST=mqtt.example.lan
MQTT_PORT=1883
MQTT_USER=birdnet
MQTT_TOPIC=birdnet

# --- Site -------------------------------------------------------------------
# Entered in the setup assistant; drives the range filter.
LATITUDE=52.52
LONGITUDE=13.40
TZ=Europe/Berlin
PUID=1000
PGID=1000
# Species name locales for Saezuri, comma separated.
SPECIES_DICT_LOCALES=en

# --- Optional ---------------------------------------------------------------
# API key for generating missing artwork. Starts with AIza, around 39
# characters. An OAuth token (AQ.Ab8…, 53 characters) is rejected with 400.
#GEMINI_API_KEY=
# Token from the BirdNET-Go interface, if it requires one.
#BIRDNETGO_TOKEN=
